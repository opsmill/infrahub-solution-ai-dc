{% set device = data.NetworkDevice.edges[0].node %}
{% set fabric = device.pod.node.parent.node %}
{% set overlay_asn = device.asn.value if device.asn.value is not none else fabric.overlay_asn.value %}
{# Materialized VRFs (leaf-only): derived once so both the BGP and overlay sections can reference them. #}
{% set vns = namespace(vrf_names=[], vrfs=[]) %}
{% for segment_edge in device.segments.edges %}
  {% set segment = segment_edge.node %}
  {% if segment.gateway.node and segment.vrf.node and segment.vrf.node.name.value not in vns.vrf_names %}
    {% set vns.vrf_names = vns.vrf_names + [segment.vrf.node.name.value] %}
    {% set vns.vrfs = vns.vrfs + [segment.vrf.node] %}
  {% endif %}
{% endfor %}
{% set is_rr = device.bgp_sessions.edges | selectattr("node.rr_client.value") | list | length > 0 %}
hostname {{ device.hostname.value }}

{# --- System / base --- #}
no ip domain-lookup
spanning-tree mode rapid-pvst

vrf context management

feature ospf
{% if overlay_asn is not none %}
feature bgp
feature interface-vlan
feature vn-segment-vlan-based
feature nv overlay
nv overlay evpn
{% endif %}

interface mgmt0
  vrf member management
  ip address {{ device.loopback_ip.node.address.ip }}/32
  no shutdown

{# --- Underlay interfaces --- #}
{% for interface_edge in device.interfaces.edges %}
  {% set interface = interface_edge.node %}
interface {{ interface.name.value }}
{% if interface.description.value %}
  description {{ interface.description.value }}
{% endif %}
{% if interface.role.value == "server" and interface.ip_address.node %}
  no switchport
{% endif %}
{% if interface.status.value == "inactive" %}
  shutdown
{% else %}
  no shutdown
{% endif %}
{% if interface.ip_address.node %}
  ip address {{ interface.ip_address.node.address.value }}
{% endif %}
{% if interface.role.value in ["super_spine", "spine", "leaf"] and interface.status.value != "inactive" %}
  ip ospf network point-to-point
  ip router ospf UNDERLAY area 0.0.0.0
{% elif interface.role.value in ["loopback", "vtep"] %}
  ip router ospf UNDERLAY area 0.0.0.0
{% endif %}

{% endfor %}
router ospf UNDERLAY
  router-id {{ device.loopback_ip.node.address.ip }}

{# --- EVPN control plane: iBGP L2VPN-EVPN sessions modeled as data (NetworkBGPSession, ADR-0005) --- #}
{% if overlay_asn is not none %}
router bgp {{ overlay_asn }}
  router-id {{ device.loopback_ip.node.address.ip }}
  address-family l2vpn evpn
{% if is_rr %}
    retain route-target all
{% endif %}
{% for session_edge in device.bgp_sessions.edges | sort(attribute="node.peer_device.node.hostname.value") %}
  {% set session = session_edge.node %}
{% if session.address_family.value == "ipv4_unicast" %}
  {% set sns = namespace(addr="") %}
  {% for iface_edge in session.peer_device.node.interfaces.edges %}
    {% if not sns.addr and iface_edge.node.ip_address.node %}
      {% set sns.addr = iface_edge.node.ip_address.node.address.value.split("/")[0] %}
    {% endif %}
  {% endfor %}
{% if sns.addr %}
  neighbor {{ sns.addr }} remote-as {{ session.remote_as.value }}
    address-family ipv4 unicast
{% endif %}
{% else %}
  neighbor {{ session.peer_device.node.loopback_ip.node.address.ip }} remote-as {{ session.remote_as.value if session.remote_as.value is not none else overlay_asn }}
    update-source loopback0
    address-family l2vpn evpn
      send-community extended
{% if session.rr_client.value %}
      route-reflector-client
{% endif %}
{% endif %}
{% endfor %}
{% for vrf in vns.vrfs %}
  vrf {{ vrf.name.value }}
    address-family ipv4 unicast
      advertise l2vpn evpn
{% endfor %}
{% endif %}

{# --- Tenant overlay state: leaf-only (a device with no materialized segments renders none of this) --- #}
{% if device.segments.edges %}
fabric forwarding anycast-gateway-mac {{ fabric.anycast_gateway_mac.value if fabric.anycast_gateway_mac.value else "0000.5e00.0001" }}

{% for segment_edge in device.segments.edges %}
  {% set segment = segment_edge.node %}
vlan {{ segment.vlan_id.value }}
  vn-segment {{ segment.l2vni.value }}
{% endfor %}
{% for vrf in vns.vrfs %}
vlan {{ vrf.l3_vlan_id.value }}
  vn-segment {{ vrf.l3vni.value }}
{% endfor %}

{% for vrf in vns.vrfs %}
vrf context {{ vrf.name.value }}
  vni {{ vrf.l3vni.value }}
  rd {{ device.loopback_ip.node.address.ip }}:{{ vrf.l3vni.value }}
  address-family ipv4 unicast
    route-target both {{ vrf.route_target.value }} evpn
{% endfor %}

interface nve1
  no shutdown
  source-interface loopback1
  host-reachability protocol bgp
{% for segment_edge in device.segments.edges %}
  {% set segment = segment_edge.node %}
  member vni {{ segment.l2vni.value }}
    suppress-arp
    ingress-replication protocol bgp
{% endfor %}
{% for vrf in vns.vrfs %}
  member vni {{ vrf.l3vni.value }} associate-vrf
{% endfor %}

{% for vrf in vns.vrfs %}
interface Vlan{{ vrf.l3_vlan_id.value }}
  description L3VNI transit SVI for {{ vrf.name.value }}
  vrf member {{ vrf.name.value }}
  ip forward
  no shutdown
{% endfor %}
{% for segment_edge in device.segments.edges %}
  {% set segment = segment_edge.node %}
{% if segment.gateway.node %}
interface Vlan{{ segment.vlan_id.value }}
  description Anycast gateway for {{ segment.name.value }}
  vrf member {{ segment.vrf.node.name.value }}
  no ip redirects
  ip address {{ segment.gateway.node.address.value }}
  fabric forwarding mode anycast-gateway
  no shutdown
{% endif %}
{% endfor %}
{% endif %}
