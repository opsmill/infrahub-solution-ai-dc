{# This template assumes Cumulus Linux 5.x running in classic (non-NVUE) configuration mode --
   NVUE is 5.x's default control plane and owns /etc/network/interfaces and frr.conf directly
   when active, rather than consuming hand-edited files. Applying this rendered artifact to an
   NVUE-managed switch, or to a pre-5.x install, is unverified. #}
{% set device = data.NetworkDevice.edges[0].node %}
{% set fabric = device.pod.node.parent.node %}
{% set overlay_asn = device.asn.value if device.asn.value is not none else fabric.overlay_asn.value %}
{# Materialized VRFs (leaf-only): derived once so both the FRR and overlay sections can reference them. #}
{% set vns = namespace(vrf_names=[], vrfs=[]) %}
{% for segment_edge in device.segments.edges %}
  {% set segment = segment_edge.node %}
  {% if segment.gateway.node and segment.vrf.node and segment.vrf.node.name.value not in vns.vrf_names %}
    {% set vns.vrf_names = vns.vrf_names + [segment.vrf.node.name.value] %}
    {% set vns.vrfs = vns.vrfs + [segment.vrf.node] %}
  {% endif %}
{% endfor %}
{% set is_rr = device.bgp_sessions.edges | selectattr("node.rr_client.value") | list | length > 0 %}
{# Sessions split by address family, load-bearing not cosmetic: an EVPN session is iBGP to the peer's
   *loopback*, while an attached server's ipv4-unicast session is eBGP to the /31 on the peer's own
   interface. Only a NetworkDevice peer exposes loopback_ip; letting a server session through the EVPN
   loop dereferences a field its peer (NetworkServer) does not have. Same split every other vendor uses. #}
{% set evpn_sessions = device.bgp_sessions.edges | rejectattr("node.address_family.value", "equalto", "ipv4_unicast") | list %}
{% set ipv4_sessions = device.bgp_sessions.edges | selectattr("node.address_family.value", "equalto", "ipv4_unicast") | list %}
{# The VTEP loopback (role vtep) is never a separate `iface` stanza -- it becomes a second `address`
   line under the single `lo` stanza (research.md D4) and the `vxlan-local-tunnelip` value below. #}
{% set vtep = namespace(addr="") %}
{% for interface_edge in device.interfaces.edges %}
  {% set interface = interface_edge.node %}
  {% if interface.role.value == "vtep" and interface.ip_address.node %}
    {% set vtep.addr = interface.ip_address.node.address.value.split("/")[0] %}
  {% endif %}
{% endfor %}
# Startup configuration: {{ device.hostname.value }}
#
# --- /etc/network/interfaces (ifupdown2) -- applied by `ifreload -a` (or present at boot as the file itself) ---
{% for interface_edge in device.interfaces.edges %}
  {% set interface = interface_edge.node %}
{% if interface.role.value not in ["loopback", "vtep"] %}
{% if interface.status.value == "inactive" %}
auto {{ interface.name.value }}
iface {{ interface.name.value }}
{% if interface.description.value %}
    alias {{ interface.description.value }}
{% endif %}
    link-down yes
{% else %}
auto {{ interface.name.value }}
iface {{ interface.name.value }}
{% if interface.description.value %}
    alias {{ interface.description.value }}
{% endif %}
{% if interface.role.value in ["super_spine", "spine", "leaf", "server"] and interface.ip_address.node %}
    address {{ interface.ip_address.node.address.value }}
{% endif %}
{% endif %}

{% endif %}
{% endfor %}
auto lo
iface lo inet loopback
    address {{ device.loopback_ip.node.address.ip }}/32
{% if vtep.addr %}
    address {{ vtep.addr }}/32
{% endif %}

{% if device.segments.edges %}
{% for vrf in vns.vrfs %}
auto {{ vrf.name.value }}
iface {{ vrf.name.value }}
    vrf-table auto

{% endfor %}
{% set l2vnis = (device.segments.edges | map(attribute="node.l2vni.value") | list) + (vns.vrfs | map(attribute="l3vni.value") | list) %}
{% set vlan_ids = (device.segments.edges | map(attribute="node.vlan_id.value") | list) + (vns.vrfs | map(attribute="l3_vlan_id.value") | list) %}
auto bridge
iface bridge
    bridge-vlan-aware yes
    bridge-ports {% for l2vni in l2vnis %}vni{{ l2vni }}{% if not loop.last %} {% endif %}{% endfor %}

    bridge-vids {% for vlan_id in vlan_ids %}{{ vlan_id }}{% if not loop.last %} {% endif %}{% endfor %}


{% for segment_edge in device.segments.edges %}
  {% set segment = segment_edge.node %}
auto vni{{ segment.l2vni.value }}
iface vni{{ segment.l2vni.value }}
    vxlan-id {{ segment.l2vni.value }}
{% if vtep.addr %}
    vxlan-local-tunnelip {{ vtep.addr }}
{% else %}
    # ERROR: no addressed vtep-role interface found on {{ device.hostname.value }} -- VXLAN tunnel cannot be configured
{% endif %}
    bridge-access {{ segment.vlan_id.value }}

{% if segment.gateway.node and segment.vrf.node %}
auto vlan{{ segment.vlan_id.value }}
iface vlan{{ segment.vlan_id.value }}
    address {{ segment.gateway.node.address.value }}
    vlan-raw-device bridge
    vlan-id {{ segment.vlan_id.value }}
    vrf {{ segment.vrf.node.name.value }}

{% endif %}
{% endfor %}
{# L3VNI transit VXLAN + SVI per materialized VRF -- the symmetric-IRB routed leg. No `address` line on
   the SVI: it is a transit interface into the VRF, not an anycast gateway (same shape as Cisco's
   `interface Vlan<l3_vlan_id>` -- startup_config_cisco.j2:140-145 -- which carries no `ip address` either). #}
{% for vrf in vns.vrfs %}
auto vni{{ vrf.l3vni.value }}
iface vni{{ vrf.l3vni.value }}
    vxlan-id {{ vrf.l3vni.value }}
{% if vtep.addr %}
    vxlan-local-tunnelip {{ vtep.addr }}
{% else %}
    # ERROR: no addressed vtep-role interface found on {{ device.hostname.value }} -- VXLAN tunnel cannot be configured
{% endif %}
    bridge-access {{ vrf.l3_vlan_id.value }}

auto vlan{{ vrf.l3_vlan_id.value }}
iface vlan{{ vrf.l3_vlan_id.value }}
    vlan-raw-device bridge
    vlan-id {{ vrf.l3_vlan_id.value }}
    vrf {{ vrf.name.value }}

{% endfor %}
{% endif %}
{% if overlay_asn is not none %}
#
# --- FRR routing config: BGP underlay, EVPN control plane, tenant overlay -- applied via `vtysh -c "configure terminal" -c ...` (or loaded as /etc/frr/frr.conf) ---
router bgp {{ overlay_asn }}
 bgp router-id {{ device.loopback_ip.node.address.ip }}
 no bgp default ipv4-unicast
{% for session_edge in evpn_sessions | sort(attribute="node.peer_device.node.hostname.value") %}
  {% set session = session_edge.node %}
 neighbor {{ session.peer_device.node.loopback_ip.node.address.ip }} remote-as {{ session.remote_as.value if session.remote_as.value is not none else overlay_asn }}
 neighbor {{ session.peer_device.node.loopback_ip.node.address.ip }} update-source lo
 neighbor {{ session.peer_device.node.loopback_ip.node.address.ip }} send-community extended
{% endfor %}
{% for session_edge in ipv4_sessions | sort(attribute="node.peer_device.node.hostname.value") %}
  {% set session = session_edge.node %}
  {% set sns = namespace(addr="") %}
  {% for iface_edge in session.peer_device.node.interfaces.edges %}
    {% if not sns.addr and iface_edge.node.ip_address.node %}
      {% set sns.addr = iface_edge.node.ip_address.node.address.value.split("/")[0] %}
    {% endif %}
  {% endfor %}
{% if sns.addr %}
 neighbor {{ sns.addr }} remote-as {{ session.remote_as.value }}
{% endif %}
{% endfor %}
 !
 address-family l2vpn evpn
{% for session_edge in evpn_sessions | sort(attribute="node.peer_device.node.hostname.value") %}
  {% set session = session_edge.node %}
  neighbor {{ session.peer_device.node.loopback_ip.node.address.ip }} activate
{% if is_rr and session.rr_client.value %}
  neighbor {{ session.peer_device.node.loopback_ip.node.address.ip }} route-reflector-client
{% endif %}
{% endfor %}
{% for segment_edge in device.segments.edges %}
  {% set segment = segment_edge.node %}
  vni {{ segment.l2vni.value }}
   rd {{ device.loopback_ip.node.address.ip }}:{{ segment.vlan_id.value }}
   route-target both {{ segment.route_target.value }}
  exit-vni
{% endfor %}
  advertise-all-vni
 exit-address-family
{% if ipv4_sessions %}
 !
 address-family ipv4 unicast
{% for session_edge in ipv4_sessions | sort(attribute="node.peer_device.node.hostname.value") %}
  {% set session = session_edge.node %}
  {% set sns = namespace(addr="") %}
  {% for iface_edge in session.peer_device.node.interfaces.edges %}
    {% if not sns.addr and iface_edge.node.ip_address.node %}
      {% set sns.addr = iface_edge.node.ip_address.node.address.value.split("/")[0] %}
    {% endif %}
  {% endfor %}
{% if sns.addr %}
  neighbor {{ sns.addr }} activate
{% endif %}
{% endfor %}
 exit-address-family
{% endif %}
exit
{% for vrf in vns.vrfs | sort(attribute="name.value") %}
!
vrf {{ vrf.name.value }}
 vni {{ vrf.l3vni.value }}
exit-vrf
!
{# Per-VRF BGP instance: the piece the static `vrf/vni/exit-vrf` binding above does not provide on its
   own -- without it the VRF's connected/local routes are never redistributed into EVPN as Type-5 routes,
   so tenant prefixes never leave this leaf (contrast startup_config_cisco.j2:96-100/112-123, which
   renders the equivalent `vrf context ... address-family ipv4 unicast / advertise l2vpn evpn` in NX-OS's
   own syntax). #}
router bgp {{ overlay_asn }} vrf {{ vrf.name.value }}
 !
 address-family ipv4 unicast
  redistribute connected
 exit-address-family
 !
 address-family l2vpn evpn
  rd {{ device.loopback_ip.node.address.ip }}:{{ vrf.l3vni.value }}
  route-target both {{ vrf.route_target.value }}
  advertise ipv4 unicast
 exit-address-family
exit
{% endfor %}
{% endif %}
